# ExcelMCP Agent — Environment Configuration
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# REQUIRED: Anthropic Claude API key (used by AI crew agents)
# Get yours at: https://console.anthropic.com/
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LLM Model Selection
# Default: claude-sonnet-4-6 (fast, capable)
# Options: claude-opus-4-6 (most capable), claude-haiku-4-5-20251001 (fastest)
# ---------------------------------------------------------------------------
AGENT_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# ExcelMCP3 System Paths
# Point these to your Jon-ExcelMCP3 installation.
# ---------------------------------------------------------------------------
EXCEL_MCP_PYTHON=c:\_Internal_ViewPoint_Projects\Jon-ExcelMCP3\venv\Scripts\python.exe
EXCEL_MCP_MAIN=c:\_Internal_ViewPoint_Projects\Jon-ExcelMCP3\main.py
EXCEL_MCP_CWD=c:\_Internal_ViewPoint_Projects\Jon-ExcelMCP3

# ---------------------------------------------------------------------------
# Input Directory
# Default location for Excel files to process.
# ---------------------------------------------------------------------------
EXCEL_MCP_INPUT_DIR=c:\_Internal_ViewPoint_Projects\Jon-ExcelMCP3\inputs
